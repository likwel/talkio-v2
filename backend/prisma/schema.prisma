// Talkio - schema Prisma
// Domaines: auth, workspaces, messagerie, appels/visio, agenda, kanban, MEAL, collecte de donnees

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth & utilisateurs
// ---------------------------------------------------------------------------

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  fullName       String
  avatarUrl      String?
  isActive       Boolean        @default(true)
  presenceStatus PresenceStatus @default(ONLINE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  memberships            WorkspaceMember[]
  channelMemberships     ChannelMember[]
  messages               Message[]
  callParticipants       CallParticipant[]
  createdCalls           Call[]               @relation("CallCreatedBy")
  assignedCards          CardAssignee[]
  comments               Comment[]
  measurements           MealMeasurement[]
  /// Chiffrement de bout en bout : clé publique + clé privée chiffrée (jamais lisible côté serveur).
  cryptoPublicKey        String?
  cryptoPrivateKeyEnc    String?
  cryptoKeyCreatedAt     DateTime?
  channelKeys            ChannelKey[]
  formResponses          FormResponse[]       @relation("FormResponseSubmitter")
  reviewedFormResponses  FormResponse[]       @relation("FormResponseReviewer")
  createdForms           Form[]               @relation("FormCreatedBy")
  createdProjects        Project[]            @relation("ProjectCreatedBy")
  calendars              Calendar[]
  createdEvents          CalendarEvent[]      @relation("EventCreatedBy")
  eventAttendances       EventAttendee[]
  friendRequestsSent     Friendship[]         @relation("FriendRequester")
  friendRequestsReceived Friendship[]         @relation("FriendAddressee")
  ledBoards              Board[]              @relation("BoardLead")
  boardMemberships       BoardMember[]
  createdAutomations     Automation[]         @relation("AutomationCreatedBy")
  createdChannels        Channel[]            @relation("ChannelCreatedBy")
  assignedActivities     Activity[]           @relation("ActivityAssignee")
  ownedRisks             Risk[]               @relation("RiskOwner")
  notifications          Notification[]       @relation("NotificationUser")
  notificationsActed     Notification[]       @relation("NotificationActor")
  formAssignments        FormAssignee[]       @relation("FormAssigneeUser")
  formAssignmentsMade    FormAssignee[]       @relation("FormAssignedBy")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Workspaces (organisations / espaces de travail)
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum PresenceStatus {
  ONLINE
  AWAY
  BUSY
  INVISIBLE
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  color     String?
  /// Photo de l'espace (URL servie par /api/uploads/files). null = pastille initiales.
  imageUrl  String?
  /// Espace personnel implicite : dépôt par défaut des Projets / MEAL / Collecte,
  /// jamais listé dans le sélecteur d'espaces de la messagerie.
  isPersonal Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  channels    Channel[]
  boards      Board[]
  calls       Call[]
  projects    Project[]
  forms       Form[]
  calendars   Calendar[]
  automations Automation[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Messagerie (canaux, messages directs, fils)
// ---------------------------------------------------------------------------

enum ChannelType {
  PUBLIC
  PRIVATE
  DIRECT
}

model Channel {
  id           String      @id @default(cuid())
  workspaceId  String
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String?
  topic        String?
  color        String?
  /// Fond de la conversation (identifiant de preset, ex : "sky"). null = defaut.
  wallpaper    String?
  /// Accuses de lecture (vu / lu) actifs pour cette conversation.
  readReceipts Boolean     @default(true)
  /// Createur de la conversation : seul a pouvoir changer certains reglages.
  createdById  String?
  creator      User?       @relation("ChannelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  type         ChannelType @default(PUBLIC)
  /// Chiffrement de bout en bout (DM / groupes privés uniquement).
  e2ee         Boolean     @default(false)
  /// Version courante de la clé de conversation (0 = non chiffré).
  e2eeVersion  Int         @default(0)
  /// Les messages antérieurs à cette date restent en clair.
  e2eeSince    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  members     ChannelMember[]
  messages    Message[]
  calls       Call[]
  channelKeys ChannelKey[]

  @@index([workspaceId])
}

/// Clé de conversation chiffrée pour un membre donné (une par version de clé).
model ChannelKey {
  id                 String   @id @default(cuid())
  channelId          String
  channel            Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version            Int
  /// Clé publique ECDH éphémère (base64 raw) utilisée pour l'enveloppe.
  ephemeralPublicKey String
  iv                 String
  /// Clé AES de conversation, chiffrée (base64).
  wrappedKey         String
  createdAt          DateTime @default(now())

  @@unique([channelId, userId, version])
  @@index([userId])
}

model ChannelMember {
  id         String    @id @default(cuid())
  channelId  String
  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?
  isAdmin    Boolean   @default(false)
  /// Permissions par salon (surcharges ; absence de ligne = tout autorisé).
  canView    Boolean   @default(true)
  canRead    Boolean   @default(true)
  canWrite   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

enum MessageKind {
  TEXT
  CALL
  FORM
}

model Message {
  id            String      @id @default(cuid())
  channelId     String
  channel       Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body          String
  kind          MessageKind @default(TEXT)
  /// Appel associe pour les messages de type CALL (historique d'appel / visio).
  callId        String?
  call          Call?       @relation(fields: [callId], references: [id], onDelete: SetNull)
  parentId      String?
  parent        Message?    @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Message[]   @relation("MessageThread")
  /// Nom de l'auteur d'origine quand le message a ete transfere (repost).
  forwardedFrom String?
  /// Formulaire partage / integre dans le message (kind = FORM).
  formId        String?
  form          Form?       @relation("MessageForm", fields: [formId], references: [id], onDelete: Cascade)
  /// Chiffrement de bout en bout : `body` contient alors le texte chiffré (base64).
  encrypted     Boolean     @default(false)
  iv            String?
  keyVersion    Int?
  editedAt      DateTime?
  createdAt     DateTime    @default(now())

  attachments Attachment[]

  @@index([channelId, createdAt])
  @@index([parentId])
}

model Attachment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  name      String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Appels audio / visio-conference
// ---------------------------------------------------------------------------

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ONGOING
  ENDED
  MISSED
}

model Call {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelId   String?
  channel     Channel?   @relation(fields: [channelId], references: [id], onDelete: SetNull)
  roomId      String     @unique
  type        CallType   @default(VIDEO)
  status      CallStatus @default(RINGING)
  createdById String
  createdBy   User       @relation("CallCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  startedAt   DateTime   @default(now())
  endedAt     DateTime?

  participants CallParticipant[]
  messages     Message[]

  @@index([workspaceId])
}

model CallParticipant {
  id       String    @id @default(cuid())
  callId   String
  call     Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([callId, userId])
}

// ---------------------------------------------------------------------------
// Kanban - gestion de projet
// ---------------------------------------------------------------------------

enum BoardStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model Board {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      BoardStatus @default(ACTIVE)
  color       String?
  startDate   DateTime?
  endDate     DateTime?
  leadId      String?
  lead        User?       @relation("BoardLead", fields: [leadId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  columns Column[]
  members BoardMember[]

  @@index([workspaceId])
}

model BoardMember {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([boardId, userId])
  @@index([userId])
}

model Column {
  id       String @id @default(cuid())
  boardId  String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name     String
  position Int    @default(0)
  wipLimit Int?

  cards Card[]

  @@index([boardId])
}

enum CardPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Card {
  id          String       @id @default(cuid())
  columnId    String
  column      Column       @relation(fields: [columnId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int          @default(0)
  priority    CardPriority @default(MEDIUM)
  dueDate     DateTime?
  labels      String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignees CardAssignee[]
  comments  Comment[]
  linkedActivity Activity?

  @@index([columnId, position])
}

model CardAssignee {
  id     String @id @default(cuid())
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([cardId])
}

// ---------------------------------------------------------------------------
// MEAL - Monitoring, Evaluation, Accountability & Learning
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/// Sante d'execution du projet, saisie par l'equipe M&E.
enum ProjectHealth {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  description String?
  /// But / objectif general (resume de la theorie du changement).
  goal        String?
  donor       String?
  sector      String?
  location    String?
  currency    String        @default("USD")
  status      ProjectStatus @default(ACTIVE)
  health      ProjectHealth @default(ON_TRACK)
  startDate   DateTime?
  endDate     DateTime?
  createdById String
  createdBy   User          @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  indicators  MealIndicator[]
  forms       Form[]
  activities  Activity[]
  budgetLines BudgetLine[]
  risks       Risk[]
  feedback    FeedbackEntry[]
  lessons     Lesson[]
  reports     PeriodReport[]

  @@index([workspaceId])
}

enum LogframeLevel {
  IMPACT
  OUTCOME
  OUTPUT
  ACTIVITY
}

model MealIndicator {
  id                  String        @id @default(cuid())
  projectId           String
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code                String
  name                String
  level               LogframeLevel @default(OUTCOME)
  unit                String?
  baseline            Float?
  target              Float?
  disaggregation      String[]      @default([])
  meansOfVerification String?
  /// Hypotheses / risques associes a la ligne du cadre logique.
  assumptions         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  measurements MealMeasurement[]
  targets      IndicatorTarget[]
  activities   Activity[]

  @@unique([projectId, code])
  @@index([projectId])
}

/// Cible d'un indicateur pour une periode donnee ("2026-Q1", "2026", "2026-03").
model IndicatorTarget {
  id          String        @id @default(cuid())
  indicatorId String
  indicator   MealIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  period      String
  target      Float
  createdAt   DateTime      @default(now())

  @@unique([indicatorId, period])
  @@index([indicatorId])
}

model MealMeasurement {
  id           String        @id @default(cuid())
  indicatorId  String
  indicator    MealIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  value        Float
  periodStart  DateTime
  periodEnd    DateTime
  location     String?
  note         String?
  /// Ventilation beneficiaires (part du total `value`).
  female       Float?
  male         Float?
  youth        Float?
  disability   Float?
  /// Donnee verifiee lors d'un controle qualite (DQA).
  verified     Boolean       @default(false)
  source       String?
  dimensions   Json?
  recordedById String
  recordedBy   User          @relation(fields: [recordedById], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@index([indicatorId, periodStart])
}

enum ActivityStatus {
  PLANNED
  IN_PROGRESS
  DONE
  DELAYED
  CANCELLED
}

/// Plan de travail : action operationnelle rattachee au projet (et parfois a un indicateur).
model Activity {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  indicatorId String?
  indicator   MealIndicator? @relation(fields: [indicatorId], references: [id], onDelete: SetNull)
  title       String
  description String?
  status      ActivityStatus @default(PLANNED)
  progress    Int            @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  location    String?
  assigneeId  String?
  assignee    User?          @relation("ActivityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Horodatage de la notification de retard deja envoyee (evite les doublons).
  overdueNotifiedAt DateTime?
  /// Evenement d'agenda synchronise (echeance alignee avec le calendrier de l'espace).
  calendarEventId String?       @unique
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  /// Tache Kanban liee (bouton "Lier une tache" ou regle d'automatisation) :
  /// son statut synchronise automatiquement le statut de l'activite.
  cardId      String?        @unique
  card        Card?          @relation(fields: [cardId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([projectId, status])
}

/// Ligne budgetaire : prevu vs depense, par bailleur / categorie.
model BudgetLine {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  donor     String?
  category  String?
  planned   Float    @default(0)
  spent     Float    @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

enum RiskStatus {
  OPEN
  MITIGATED
  CLOSED
}

/// Registre des risques : probabilite x impact (echelle 1..5) + mesure d'attenuation.
model Risk {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  likelihood  Int        @default(3)
  impact      Int        @default(3)
  mitigation  String?
  status      RiskStatus @default(OPEN)
  ownerId     String?
  owner       User?      @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId, status])
}

enum FeedbackType {
  COMPLAINT
  SUGGESTION
  QUESTION
  APPRECIATION
}

enum FeedbackStatus {
  NEW
  IN_REVIEW
  RESOLVED
  CLOSED
}

/// Mecanisme de redevabilite : retours et plaintes des communautes.
model FeedbackEntry {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        FeedbackType   @default(COMPLAINT)
  channel     String?
  category    String?
  sensitive   Boolean        @default(false)
  summary     String
  detail      String?
  reporter    String?
  location    String?
  status      FeedbackStatus @default(NEW)
  resolution  String?
  receivedAt  DateTime       @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([projectId, status])
}

/// Registre d'apprentissage : lecons tirees de la mise en oeuvre.
model Lesson {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  category       String?
  context        String?
  insight        String
  recommendation String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId])
}

/// Rapport de periode (narratif) ; les chiffres sont recalcules a l'affichage.
model PeriodReport {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  period       String
  title        String
  narrative    String?
  achievements String?
  challenges   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Collecte de donnees - formulaires dynamiques
// ---------------------------------------------------------------------------

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  INTEGER
  DECIMAL
  DATE
  DATETIME
  TIME
  EMAIL
  PHONE
  URL
  RATING
  RANGE
  SELECT
  MULTISELECT
  BOOLEAN
  ACKNOWLEDGE
  NOTE
  BARCODE
  SIGNATURE
  GEOPOINT
  PHOTO
}

/// Statut de validation d'une soumission (revue qualité, façon Kobo).
enum ReviewState {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

model Form {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  description String?
  status      FormStatus @default(DRAFT)
  /// Numéro de version, incrémenté à chaque (re)publication.
  version     Int        @default(1)
  /// Autoriser plusieurs soumissions depuis le même appareil.
  allowMultiple Boolean  @default(true)
  /// Exiger un compte pour répondre (désactive le lien public anonyme).
  requireLogin  Boolean  @default(false)
  /// Code court (5 caractères) pour le lien public /f/<code>.
  publicCode  String?    @unique
  createdById String
  createdBy   User       @relation("FormCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  sections  FormSection[]
  fields    FormField[]
  responses FormResponse[]
  messages  Message[]      @relation("MessageForm")
  assignees FormAssignee[] @relation("FormAssignees")

  @@index([workspaceId])
}

/// Section / groupe de questions (façon groupe ODK). Une section « repeatable »
/// collecte N entrées d'un sous-formulaire (façon `repeat` XLSForm).
model FormSection {
  id            String       @id @default(cuid())
  formId        String
  form          Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  key           String
  title         String
  description   String?
  position      Int          @default(0)
  repeatable    Boolean      @default(false)
  repeatLabel   String?
  minRepeat     Int?
  maxRepeat     Int?
  /// N'afficher la section que si <relevantField> <op> <value>.
  relevantField String?
  relevantOp    String?
  relevantValue String?

  fields FormField[]

  @@unique([formId, key])
  @@index([formId])
}

model FormField {
  id           String       @id @default(cuid())
  formId       String
  form         Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  sectionId    String?
  section      FormSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  label        String
  key          String
  type         FieldType    @default(TEXT)
  required     Boolean      @default(false)
  position     Int          @default(0)
  options      String[]     @default([])
  helpText     String?
  placeholder  String?
  defaultValue String?
  minValue     Float?
  maxValue     Float?
  pattern      String?
  /// Skip logic : n'afficher le champ que si <relevantField> <op> <value>.
  relevantField     String?
  relevantOp        String?
  relevantValue     String?
  /// Contrainte de validation (expression, `.` = valeur du champ) + message.
  constraintExpr    String?
  constraintMessage String?
  /// Expression calculée (champ en lecture seule), ex. `{poids} / ({taille} * {taille})`.
  calculation       String?
  /// Indice de rendu (minimal, columns, likert…).
  appearance        String?
  rangeStep         Float?

  answers FormAnswer[]

  @@unique([formId, key])
  @@index([formId])
  @@index([sectionId])
}

model FormResponse {
  id            String      @id @default(cuid())
  formId        String
  form          Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  submittedById String?
  submittedBy   User?       @relation("FormResponseSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  /// E-mail du participant (obligatoire sur le lien public).
  email         String?
  submittedAt   DateTime    @default(now())
  latitude      Float?
  longitude     Float?
  /// Version du formulaire au moment de la saisie.
  formVersion   Int         @default(1)
  /// Identifiant d'appareil (déduplication / traçabilité terrain).
  deviceId      String?
  /// Revue qualité (façon Kobo).
  reviewState   ReviewState @default(PENDING)
  reviewNote    String?
  reviewedById  String?
  reviewedBy    User?       @relation("FormResponseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?

  answers FormAnswer[]

  @@index([formId, submittedAt])
  @@index([formId, reviewState])
}

model FormAnswer {
  id         String       @id @default(cuid())
  responseId String
  response   FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  fieldId    String
  field      FormField    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value      Json
  /// Indice d'itération pour les champs d'une section répétable (0 sinon).
  groupIndex Int          @default(0)

  @@unique([responseId, fieldId, groupIndex])
}

// ---------------------------------------------------------------------------
// Agenda / calendrier
// ---------------------------------------------------------------------------

model Calendar {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  color       String    @default("#ff2c5f")
  isDefault   Boolean   @default(false)
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  events CalendarEvent[]

  @@index([workspaceId, ownerId])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  calendarId  String
  calendar    Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  title       String
  description String?
  location    String?
  color       String?
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean  @default(false)
  createdById String
  createdBy   User     @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendees EventAttendee[]
  activity  Activity?

  @@index([calendarId, startsAt])
  @@index([startsAt, endsAt])
}

enum AttendeeStatus {
  INVITED
  ACCEPTED
  DECLINED
  TENTATIVE
}

model EventAttendee {
  id      String         @id @default(cuid())
  eventId String
  event   CalendarEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status  AttendeeStatus @default(INVITED)

  @@unique([eventId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Systeme d'amitie
// ---------------------------------------------------------------------------

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Friendship {
  id          String       @id @default(cuid())
  requesterId String
  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// ---------------------------------------------------------------------------
// Automatisation (regles declencheur -> action inter-modules)
// ---------------------------------------------------------------------------

model Automation {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  enabled       Boolean   @default(true)
  triggerType   String // form.response.created | card.moved.done | meal.measurement.created | message.keyword
  triggerConfig Json      @default("{}")
  actionType    String // message.post | card.create
  actionConfig  Json      @default("{}")
  lastRunAt     DateTime?
  runCount      Int       @default(0)
  createdById   String
  createdBy     User      @relation("AutomationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId, enabled])
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  PROJECT_ASSIGNED
  RISK_ASSIGNED
  MEASUREMENT_ADDED
  FORM_RESPONSE
  FORM_ASSIGNED
  ACTIVITY_OVERDUE
  GENERIC
}

enum FormAssigneeStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// Attribution d'un formulaire a un utilisateur (il doit l'accepter puis le remplir).
model FormAssignee {
  id           String             @id @default(cuid())
  formId       String
  form         Form               @relation("FormAssignees", fields: [formId], references: [id], onDelete: Cascade)
  userId       String
  user         User               @relation("FormAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?              @relation("FormAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  status       FormAssigneeStatus @default(PENDING)
  note         String?
  dueAt        DateTime?
  respondedAt  DateTime?
  createdAt    DateTime           @default(now())

  @@unique([formId, userId])
  @@index([userId, status])
}

/// Notification in-app (bulle) : demande d'ami, assignation projet, suivi, formulaire…
model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String?
  /// Chemin frontend a ouvrir au clic (ex : /meal/projects/xxx?t=workplan).
  link       String?
  actorId    String?
  actor      User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
